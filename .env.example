# ==============================================================================
# Clothing Store Management System — Backend Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ── PostgreSQL Database ───────────────────────────────────────────────────────
# Default points at the optional local container (docker compose --profile local-db up -d).
# For a hosted database (e.g. Render) put its external host here and set the matching DB/user/password.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=clothing_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_secure_password_123

# ── Redis (Cache & Celery Broker) ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_123
REDIS_DB=0

# ── Backend Security & JWT ────────────────────────────────────────────────────
SECRET_KEY=replace_with_a_super_secret_cryptographic_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004"]
ENVIRONMENT=development

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://:redis_secure_password_123@redis:6379/0
CELERY_RESULT_BACKEND=redis://:redis_secure_password_123@redis:6379/0

# ── File Uploads & Local Storage ──────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ── Seed Administrator Credentials ───────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@clothingstore.com
SEED_ADMIN_PASSWORD=admin123456

# ── MinIO Object Storage (S3-Compatible) ──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=clothing-store
MINIO_USE_SSL=false
MINIO_PUBLIC_URL=http://localhost:9000

# ── ABA PayWay Payment Gateway ────────────────────────────────────────────────
PAYWAY_ENABLED=true
PAYWAY_BASE_URL=https://checkout-sandbox.payway.com.kh
PAYWAY_MERCHANT_ID=ec438867
PAYWAY_PUBLIC_KEY=your_payway_api_key
PAYWAY_RSA_PUBLIC_KEY=
PAYWAY_RSA_PRIVATE_KEY=
PAYWAY_CALLBACK_BASE_URL=http://localhost:8000
PAYWAY_QR_LIFETIME_MINUTES=10

# ── Telegram Notifications ────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_GROUP_ID=

