# ==============================================================================
# Clothing Store Management System — Backend Environment Variables
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# ── PostgreSQL Database (Hosted / External) ──────────────────────────────────
# Configure your hosted PostgreSQL database (e.g., Render, Neon, Supabase)
POSTGRES_SERVER=your-postgres-host.render.com
POSTGRES_PORT=5432
POSTGRES_DB=clothing_store_db
POSTGRES_USER=clothing_store_user
POSTGRES_PASSWORD=your_secure_password
POSTGRES_SSL=require

# ── Redis (Cache & Celery Broker) ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password_123
REDIS_DB=0

# ── Backend Security & JWT ────────────────────────────────────────────────────
SECRET_KEY=replace_with_a_super_secret_cryptographic_key_at_least_32_chars_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:3001","http://localhost:3002","http://localhost:3003","http://localhost:3004"]
ENVIRONMENT=development

# ── Internal Service Authentication ───────────────────────────────────────────
SYSTEM_AUTH_HEADER_NAME=X-System-Authorization
SYSTEM_AUTH_MODE=audit
SYSTEM_AUTH_SECRET_CURRENT=internal_system_auth_secret_current
SYSTEM_AUTH_SECRET_PREVIOUS=internal_system_auth_secret_previous

# ── File Uploads & Local Storage ──────────────────────────────────────────────
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=10

# ── Seed Administrator Credentials ───────────────────────────────────────────
SEED_ADMIN_EMAIL=admin@clothingstore.com
SEED_ADMIN_PASSWORD=admin123456

# ── Cloudflare R2 Object Storage (S3-Compatible) ──────────────────────────────
R2_ACCOUNT_ID=your_r2_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=clothing-store
R2_PUBLIC_URL=https://your-domain.store/uploads

# ── Integrations (ABA PayWay & Telegram) ──────────────────────────────────────
# NOTE: Payment Gateway (ABA PayWay) credentials and Telegram notification
# bot/channel configurations have been migrated to the database (`auth.system`,
# `auth.system_credential`, `auth.telegram_bot`, `auth.telegram_chat`).
# Manage them dynamically in the Admin Portal under Settings -> Integrations Hub
# or via the API (`/api/v1/settings/payment-gateway` and `/api/v1/auth/telegram`).
